{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["priority", "trigger", "request"],
  "additionalProperties": false,
  "properties": {
    "priority": { "enum": ["urgent", "routine"] },
    "trigger": { "type": "string", "minLength": 1 },
    "request": { "type": "string", "minLength": 1 }
  }
}
