#!/bin/sh
# secrets — scan the current tree and every patch reachable from local refs.
set -eu

REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
VERSION=8.30.1
GITLEAKS="$REPO/.tools/gitleaks/$VERSION/gitleaks"
PREPARE='sh sdlc/scripts/install'

[ ! -e "$REPO/.gitleaksignore" ] || { echo "secrets: .gitleaksignore is not permitted; review .gitleaks.toml instead." >&2; exit 1; }
[ -x "$GITLEAKS" ] || { echo "secrets: Gitleaks $VERSION is missing; run $PREPARE" >&2; exit 1; }
[ "$("$GITLEAKS" version 2>/dev/null || :)" = "$VERSION" ] || { echo "secrets: Gitleaks $VERSION is required; run $PREPARE" >&2; exit 1; }
[ "$(git -C "$REPO" rev-parse --is-shallow-repository 2>/dev/null || :)" = false ] || { echo "secrets: full Git history is required; this repository is shallow or unreadable." >&2; exit 1; }

LOG=$(mktemp "${TMPDIR:-/tmp}/botassembly-gitleaks.XXXXXX") || { echo "secrets: cannot create a private diagnostic file." >&2; exit 1; }
chmod 600 "$LOG"
trap 'rm -f "$LOG"' EXIT HUP INT TERM

scan() {
	: >"$LOG"
	if (cd "$REPO" && "$GITLEAKS" "$@" 2>"$LOG"); then
		if [ -s "$LOG" ]; then
			cat "$LOG" >&2
			echo "secrets: Gitleaks reported a warning or error." >&2
			exit 1
		fi
	else
		cat "$LOG" >&2
		exit 1
	fi
}

scan dir \
	"--config=$REPO/.gitleaks.toml" \
	'--redact=100' \
	'--no-banner' \
	'--no-color' \
	'--ignore-gitleaks-allow' \
	'--log-level=warn' \
	'.'
scan git \
	"--config=$REPO/.gitleaks.toml" \
	'--redact=100' \
	'--no-banner' \
	'--no-color' \
	'--ignore-gitleaks-allow' \
	'--log-level=warn' \
	'--log-opts=--all --full-history -m' \
	'.'
