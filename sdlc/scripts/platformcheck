#!/bin/sh
# Narrow offline qualification shared by the hosted Linux and macOS jobs.
set -eu

case $0 in
*/platformcheck) REPO=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd) ;;
*) REPO=$(git rev-parse --show-toplevel) ;;
esac
cd -- "$REPO"

system=$(uname -s)
case $system in
Linux|Darwin) ;;
*) echo "platformcheck: unsupported system: $system" >&2; exit 2 ;;
esac

make installcheck
sh sdlc/scripts/examples

files='tests/cli-assembly-install-atomic.test.ts tests/cli-assembly-install-process.test.ts tests/install-refuses-a-non-assembly.test.ts tests/owned-removal.test.ts tests/flow-cleanup.test.ts tests/process.test.ts tests/cli-signal-boundary.test.ts tests/subflow-local-signal.test.ts tests/cli-worktree-lock.test.ts tests/run-birth-reservation.test.ts tests/request-limit.test.ts tests/process-stdin.test.ts tests/cli-exit.test.ts tests/ordinary-cli-output.test.ts tests/ordinary-output.test.ts tests/raw-record-races.test.ts'
(cd bot && npm run test -- --maxWorkers=1 $files)

repeat=1
while [ "$repeat" -le 10 ]; do
	(cd bot && npm run test -- tests/install-refuses-a-non-assembly.test.ts)
	(cd bot && npm run test -- tests/subflow-local-signal.test.ts)
	repeat=$((repeat + 1))
done
