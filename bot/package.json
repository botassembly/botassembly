{
  "name": "bot",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "types", "npm-shrinkwrap.json"],
  "exports": {
    "./admin-readings": { "types": "./types/public-admin-readings.d.ts", "default": "./dist/public-admin-readings.js" },
    "./inspection": { "types": "./types/public-inspection.d.ts", "default": "./dist/public-inspection.js" },
    "./mutation-readings": { "types": "./types/public-mutation-readings.d.ts", "default": "./dist/public-mutation-readings.js" },
    "./one-run": { "types": "./types/one-run.d.ts", "default": "./dist/one-run.js" },
    "./record-lines": { "types": "./types/record-lines.d.ts", "default": "./dist/record-lines.js" },
    "./run-readings": { "types": "./types/public-run-readings.d.ts", "default": "./dist/public-run-readings.js" },
    "./session": { "types": "./types/session.d.ts", "default": "./dist/session.js" }
  },
  "bin": {
    "bot": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "prepare": "node scripts/prepare-package.mjs",
    "lint": "eslint . && node scripts/check-lint-rules.mjs && node --test scripts/check-test-model-runtime-boundary.node.mjs && node scripts/check-test-model-runtime-boundary.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "node scripts/run-coverage.mjs",
    "knip": "knip --no-config-hints",
    "cycles": "madge --circular --extensions ts src",
    "ratchet": "node ../sdlc/scripts/ratchet.mjs",
    "check:catch-budget": "node scripts/check-catch-budget.mjs",
    "check:pinned-deps": "node scripts/check-pinned-deps.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "26.1.2",
    "ajv": "8.20.0",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.0"
  },
  "bundleDependencies": [
    "@earendil-works/pi-agent-core",
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent",
    "@types/node",
    "ajv",
    "proper-lockfile",
    "yaml"
  ],
  "devDependencies": {
    "@types/proper-lockfile": "4.1.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.0",
    "knip": "6.31.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.11"
  }
}
