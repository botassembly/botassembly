{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/spine.ts", "tests/**/*.test.ts", "scripts/*.mjs"],
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"],
  // mkfifo: ticket 0011's fuzz regressions create named pipes (a POSIX
  // coreutils binary; Node has no mkfifo API) to prove the reader refuses
  // a fifo instead of blocking on it. Test-only; src/ never invokes it.
  // make: the specification-gate proof runs the repository's root check in a
  // private fixture. The runtime never invokes it.
  "ignoreBinaries": ["make", "mkfifo"]
}
